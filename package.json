{
  "name": "daggah",
  "private": true,
  "version": "0.1.0",
  "description": "Daggah — browser mobile auto-combat RPG (v1 vertical slice)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/migrate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node scripts/migrate.mjs",
    "art": "python3 scripts/process-art.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "pg": "^8.23.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
